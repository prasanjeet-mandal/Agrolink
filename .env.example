# ============================================================================
# AgroLink — environment configuration (.env)
# Copy to .env and fill in real values. Never commit the real .env file.
# ============================================================================

# --- Database (used by docker-compose MySQL + backend) ------------------------
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=agrolink
MYSQL_USER=agrolink
MYSQL_PASSWORD=agrolink_password_change_me
# Backend JDBC overrides (when running via mvnw/non-docker MySQL)
DB_URL=jdbc:mysql://localhost:3306/agrolink?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=change_me
DDL_AUTO=update

# --- JWT -----------------------------------------------------------------------
JWT_SECRET=change_this_to_a_strong_secret_key_at_least_32_chars
JWT_EXPIRATION=86400000
JWT_REGISTRATION_EXPIRATION=600000

# --- OTP -----------------------------------------------------------------------
# OTP provider: mock (fixed dev code, no credentials) or twilio (Verify V2).
OTP_PROVIDER=mock
# Dev mode: expose the fixed fallback code in the API response when provider is mock.
OTP_EXPOSE_CODE=true
# Require OTP verification before /api/auth/register
OTP_REQUIRE_VERIFY=true
# Fixed code accepted ONLY when Twilio Verify is unconfigured (dev fallback)
OTP_DEV_CODE=123456
OTP_MAX_SENDS=5
OTP_RATE_WINDOW_MINUTES=60
OTP_RESEND_COOLDOWN=30
OTP_MAX_ATTEMPTS=5
OTP_TTL_SECONDS=600

# --- CORS ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# --- AI / services --------------------------------------------------------------
AI_URL=http://localhost:8000
SERVER_PORT=8080

# --- Twilio Verify (SMS OTP) ----------------------------------------------------
# Used only when OTP_PROVIDER=twilio. The app never stores OTPs.
# Create an API key (Console → Account → API keys & tokens) for API Key SID +
# Secret, and a Verify Service (Console → Verify → Services) for the Service SID.
# Production: set these + OTP_PROVIDER=twilio and REMOVE dev-code exposure
# (OTP_EXPOSE_CODE=false).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# --- Google Sign-In (OAuth 2.0) ---------------------------------------------------
# Server-side code exchange + id_token verification (Google Cloud Console →
# Credentials → OAuth 2.0 Client IDs → Web application).
# Authorized JavaScript origins: http://localhost:5173 (and production origin).
# Authorized redirect URIs: leave "postmessage" handling (popup flow) — no URI needed.
# NEVER commit real client secret. Frontend needs only VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional) ----------------------------------------------------------------
EMAIL_FROM=no-reply@agrolink.in
MAILGUN_KEY=

# --- Payments (optional) --------------------------------------------------------------
PAYMENT_GATEWAY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Frontend build ----------------------------------------------------------------
VITE_API_BASE_URL=/